# Copy this file to .env and adjust as needed.
# Host ports exposed by Docker Compose.
# Override any value here or pass it directly on the CLI:
#   DB_PORT=5433 docker compose up
#   MODELS_PORT=8001 TAXONOMY_PORT=8081 docker compose up

DB_PORT=5432
MODELS_PORT=8000
TAXONOMY_PORT=8080
FILE_DROP_PORT=2222

